---
import DocsLayout from "../../layouts/DocsLayout.astro";

const articles = [
  { href: "/docs/getting-started", title: "快速入门", desc: "5 分钟跑通 DocMind:从下载到第一次搜索" },
  { href: "/docs/search-syntax", title: "搜索语法", desc: "AND/OR/NOT、精确短语、文件类型筛选" },
  { href: "/docs/ai-qa", title: "AI 问答指南", desc: "如何提出好问题,模型档位选择,参考来源解读" },
  { href: "/docs/faq", title: "常见问题", desc: "购买、激活、隐私、卡顿、模型 等高频问题" },
];
---

<DocsLayout title="文档" description="DocMind 使用文档">
  <h1>文档</h1>
  <p>DocMind 的所有使用指南都在这里。如果是第一次使用,从 <a href="/docs/getting-started">快速入门</a> 开始。</p>

  <div class="not-prose mt-8 grid gap-4 md:grid-cols-2">
    {articles.map((a) => (
      <a
        href={a.href}
        class="block rounded-xl border border-ink-200 bg-white p-5 transition hover:border-primary-300 hover:shadow-lg"
      >
        <h3 class="text-base font-semibold text-ink-900">{a.title}</h3>
        <p class="mt-2 text-sm text-ink-600">{a.desc}</p>
        <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-primary-600">
          阅读 →
        </span>
      </a>
    ))}
  </div>

  <h2>找不到答案?</h2>
  <p>
    通过 <a href="/contact">联系我们</a> 发邮件,
    我们一般在 1-3 个工作日内回复。
  </p>
</DocsLayout>
