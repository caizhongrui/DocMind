---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
const links = [
  { href: "/features", label: "功能" },
  { href: "/pricing", label: "定价" },
  { href: "/docs", label: "文档" },
  { href: "/download", label: "下载" },
  { href: "/changelog", label: "更新" },
];
---

<header class="sticky top-0 z-50 border-b border-ink-200 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center px-6">
    <a
      href="/"
      class="mr-8 flex items-center gap-2 text-base font-semibold tracking-tight text-ink-900 hover:opacity-80"
    >
      <span
        class="flex h-7 w-7 items-center justify-center rounded-lg bg-gradient-to-br from-primary-500 to-primary-600 text-white"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </span>
      DocMind
    </a>
    <nav class="hidden gap-6 text-sm text-ink-600 md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            "transition hover:text-ink-900",
            isActive(l.href) && "font-medium text-ink-900",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-3">
      <a
        href="/pricing"
        class="hidden rounded-md border border-ink-200 px-3 py-1.5 text-sm text-ink-600 transition hover:border-ink-300 hover:text-ink-900 sm:inline-block"
      >
        定价
      </a>
      <a
        href="/download"
        class="rounded-md bg-primary-600 px-3 py-1.5 text-sm font-medium text-white transition hover:bg-primary-700"
      >
        立即下载
      </a>
    </div>
  </div>
</header>
