# 容器内 Caddy 配置:plain HTTP only,SSL 由宿主机宝塔 Nginx 终止。
# Caddy 监听 :8080,按 Host 头分流到门户(静态)或 Axum(反代)。
#
# 宝塔 Nginx 反代规则:
#   doc-web.boyobang.com → http://127.0.0.1:8080(Host 透传)
#   doc-api.boyobang.com → http://127.0.0.1:8080(Host 透传)
#
# Caddy 看到不同 Host 头会路由到不同后端。

{
    auto_https off
    admin off
}

:8080 {
    @portal host {$PORTAL_DOMAIN}
    @api    host {$DOMAIN}

    handle @portal {
        root * {$PORTAL_ROOT}
        file_server
        encode gzip zstd
        try_files {path} {path}/index.html /index.html
        header {
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
            Cache-Control "public, max-age=300"
        }
        # hashed assets — 长缓存
        @astro path /_astro/*
        header @astro Cache-Control "public, max-age=31536000, immutable"
    }

    handle @api {
        reverse_proxy 127.0.0.1:8081 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
        # 大文件下载 + admin 上传放宽超时
        request_body {
            max_size 200MB
        }
    }

    # 兜底:未知 Host(健康检查、IP 直连等)
    handle {
        respond "DocMind backend — pass via configured domains" 200
    }
}
