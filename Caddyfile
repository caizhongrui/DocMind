# DocMind production Caddyfile.
#
# Two virtual hosts:
#   {$PORTAL_DOMAIN}       — static marketing site at /app/portal
#   {$DOMAIN}              — Axum API + admin + activate, reverse-proxied
#                            to the Rust server on 127.0.0.1:8080
#
# Caddy automatically obtains and renews TLS certs from Let's Encrypt.
# Set ACME_EMAIL via env-var to receive expiry notifications.

{
    email {$ACME_EMAIL:admin@example.com}
    admin off
}

# Marketing portal
{$PORTAL_DOMAIN} {
    encode gzip zstd
    root * /app/portal
    file_server
    try_files {path} {path}.html /index.html

    header {
        # Security
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # CORS for /api fetches from changelog page (build-time only,
        # but harmless at runtime).
        -Server
    }
}

# API + admin + activate
{$DOMAIN} {
    encode gzip zstd
    reverse_proxy 127.0.0.1:8080 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }

    # Tighter limits for upload-heavy admin endpoints (binary releases).
    request_body {
        max_size 200MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
