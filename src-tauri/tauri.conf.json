{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docmind",
  "version": "0.1.0",
  "identifier": "com.caizhongrui.docmind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "docmind",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1RjBDOEZENDczNzBFMzYKUldRMkRqZEgvY2p3NWY5aHMxcVVFWlNJS2NUbXVNcXFKUFErS3FUR0ViaVEvRjhUVUhiSlg4N00K",
      "endpoints": ["https://update.docmind.app/latest.json"],
      "dialog": false
    }
  }
}
