{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docmind",
  "version": "0.2.0",
  "identifier": "com.caizhongrui.docmind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "docmind",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwOENCM0VCRDEyNUI1NEIKUldSTHRTWFI2N09NUURDNkIzRnh5OVpkV1hTaFJKNDRSSGx0d3NhYUVQLys5emVaWllYZC9GZkYK",
      "endpoints": [
        "https://doc-api.boyobang.com/api/v1/updates/{{target}}-{{arch}}/{{current_version}}"
      ],
      "dialog": false
    }
  }
}
