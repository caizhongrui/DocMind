# ─── Domains ───────────────────────────────────────────────────────────────
# Both domains must already point at this server's public IP via DNS A
# records. Caddy will obtain TLS certs automatically.
DOMAIN=doc-api.boyobang.com
PORTAL_DOMAIN=doc-web.boyobang.com
ACME_EMAIL=you@example.com

# ─── Admin login for the /admin web UI ────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ─── PayJS payment ─────────────────────────────────────────────────────────
# Get these from https://payjs.cn after merchant registration.
PAYJS_MERCHANT_ID=
PAYJS_KEY=
PAYJS_NOTIFY_URL=https://doc-api.boyobang.com/api/v1/payment/payjs/webhook

# ─── Pricing (in 分/cents, 2000 = ¥20) ─────────────────────────────────────
PRICE_LIFETIME_FEN=2000

# ─── Logging ───────────────────────────────────────────────────────────────
RUST_LOG=info,docmind_server=debug
