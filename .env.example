# ─── 域名 ──────────────────────────────────────────────────────────────────
# 两个子域要先 DNS 解析到这台服务器,SSL 由宝塔 Nginx 处理。
DOMAIN=doc-api.boyobang.com
PORTAL_DOMAIN=doc-web.boyobang.com

# ─── /admin 后台登录 ──────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ─── 微信支付凭据 ──────────────────────────────────────────────────────────
# 来自微信商户后台 https://pay.weixin.qq.com → 账户中心 / API 安全
WECHAT_MCH_ID=                # 商户号(10 位数字)
WECHAT_APP_ID=                # 公众号 / 服务号 AppID(扫码支付绑定的应用)
WECHAT_API_V3_KEY=            # API v3 密钥(32 字符,商户后台手动设置)
WECHAT_MCH_CERT_SERIAL_NO=    # 商户证书序列号(40 字符 hex)

# 私钥与平台证书 — 不通过环境变量,而是放到 data/wechat/ 目录:
#   ./data/wechat/apiclient_key.pem    商户 API 私钥
#   ./data/wechat/wechatpay_cert.pem   微信支付平台证书

# 异步通知地址(支付回调),需在微信商户后台设置同样的 URL
WECHAT_NOTIFY_URL=https://doc-api.boyobang.com/api/v1/payment/wechat/webhook

# ─── 价格(分,2000 = ¥20)─────────────────────────────────────────────────
PRICE_LIFETIME_FEN=2000
